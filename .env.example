# SQL Server (required)
# Must meet complexity: 8+ chars, uppercase, lowercase, digits, symbols
MSSQL_SA_PASSWORD=YourPassword123!

# Seed configuration (optional)
# Number of user profiles to seed when database is empty (default: 500)
SEED_USER_COUNT=500

# Frontend API URL (optional)
# URL the browser uses to reach the backend API (default: http://localhost:8080)
NEXT_PUBLIC_API_URL=http://localhost:8080
