# Copy this file to .env before running docker compose.

# SQL Server requires 8+ chars with uppercase, lowercase, digit, and symbol.
MSSQL_SA_PASSWORD=YourPassword123!

# Host ports.
MSSQL_PORT=1433
BACKEND_PORT=8080
FRONTEND_PORT=3000
ADMINER_PORT=8081

# Browser-facing API URL baked into the Next.js build.
NEXT_PUBLIC_API_URL=http://localhost:8080

# JWT secret (min 64 chars recommended).
JWT_SECRET=your-jwt-secret-key-here-min-64-characters-long-replace-this

# SMTP settings used by the backend to send verification/reset emails.
# For Gmail, SMTP_PASSWORD must be an app password, not your normal account password.
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_ENABLE_SSL=true
SMTP_EMAIL=your-email@gmail.com
SMTP_PASSWORD=your-gmail-app-password

# Cloudinary settings for image storage.
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret
