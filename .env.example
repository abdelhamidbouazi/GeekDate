# Copy this file to .env before running docker compose.

# SQL Server requires 8+ chars with uppercase, lowercase, digit, and symbol.
MSSQL_SA_PASSWORD=YourPassword123!

# Host ports.
MSSQL_PORT=1433
BACKEND_PORT=8080
FRONTEND_PORT=3000
ADMINER_PORT=8081

# Browser-facing API URL baked into the Next.js build.
NEXT_PUBLIC_API_URL=http://localhost:8080
